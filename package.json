{
  "name": "guardian-group-gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Guardian Group — static corporate gateway page",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "check:manifest": "node scripts/check-manifest.mjs",
    "logos": "node scripts/prepare-logos.mjs",
    "test": "npm run build && playwright test",
    "test:only": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capsizecss/metrics": "4.3.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
